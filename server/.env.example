# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster> with your MongoDB Atlas credentials
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kisansetu?retryWrites=true&w=majority
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/kisansetu_test

# Authentication & Security
JWT_SECRET=replace_with_a_64_char_cryptographic_random_hex_secret
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
CLIENT_ORIGIN=http://localhost:5173

# Initial Admin Setup (Used only by `npm run seed` when creating the initial admin account)
ADMIN_INITIAL_EMAIL=admin@kisansetu.org
ADMIN_INITIAL_PASSWORD=ChangeMeImmediately!2026

# Official Government Data Integration (Data.gov.in AGMARKNET API)
# Dataset: Current Daily Price of Various Commodities from Various Markets (Mandi)
# Resource ID: 9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
